# Copy to .env and adjust as needed. Every value below is optional; the
# defaults shown are what the server uses when the variable is unset.

# Port the Node server listens on.
PORT=3000

# Network interface Express binds to. This is the listening address, not the
# address you open: use http://localhost:3000 in the browser.
HOST=0.0.0.0

# Where learner progress and practice sessions are stored.
BASSLAB_DATA_FILE=.data/learners.json

# Directory holding the built React client, served in production mode.
BASSLAB_CLIENT_DIR=dist/client

# Set to 1 when running behind exactly one trusted reverse proxy, so that
# per-client rate limiting sees the real client address instead of the proxy's.
# TRUST_PROXY=1
